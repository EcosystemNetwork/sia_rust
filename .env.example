# sia_rust credentials — copy to `.env` and fill in real keys.
#
#   cp .env.example .env
#
# The real process environment ALWAYS wins: any variable already exported in
# your shell overrides the value here. `.env` is gitignored; never commit real
# keys. See docs/CREDENTIALS.md for which provider needs which key.
#
# These are PLACEHOLDERS ONLY — replace with your own keys.

# Anthropic (provider: anthropic; default meta/feedback agent + `claude` runner)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the Anthropic base URL (e.g. a gateway/proxy).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI (provider: openai; also the fallback when no provider is supplied)
OPENAI_API_KEY=your-openai-api-key-here

# Nebius Token Factory (provider: nebius; OpenAI-compatible)
# Base URL comes from the provider JSON, not an env var; for a different region
# create a custom provider JSON (see docs/NEBIUS_QUICKSTART.md).
NEBIUS_API_KEY=your-nebius-api-key-here

# Together AI (provider: together; OpenAI-compatible)
TOGETHER_API_KEY=your-together-api-key-here

# Google Gemini (provider: gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Tavily web search (optional; agent-ready web search — issue #106)
# Free tier: 1,000 credits/month. Get a key at https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# --------------------------------------------------------------------------- #
# Superradiant credential store + house competitors (build: --features
# superradiant-db). Lets users enter provider API keys in the UI and run models
# in-process. Without DATABASE_URL the credential UI is disabled; external
# workers still work.
# --------------------------------------------------------------------------- #

# Postgres connection string. Railway's PG plugin sets this automatically.
# For Supabase, use the Connection Pooler URI (Transaction mode, port 6543):
#   DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# 32-byte key (base64) that encrypts user-entered API keys at rest. REQUIRED
# when DATABASE_URL is set. Generate one with:
#   openssl rand -base64 32
# SUPERRADIANT_SECRET_KEY=replace-with-openssl-rand-base64-32

# Admin token gating all control + credential endpoints.
# SUPERRADIANT_ADMIN_TOKEN=choose-a-strong-token

# Allowed CORS origins for a split deploy (frontend on Vercel → backend on
# Railway). Comma-separated; unset = permissive (dev only).
# SUPERRADIANT_CORS_ORIGIN=https://your-frontend.vercel.app

# Cloud platforms inject $PORT; the server then binds 0.0.0.0:$PORT.
# PORT=8000
